{
  "manifest_version": 3,
  "name": "TruthLens AI — Credibility Overlay",
  "version": "1.0",
  "description": "Real-time misinformation risk alerts on YouTube.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1:5001/*",
    "http://localhost:5001/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}